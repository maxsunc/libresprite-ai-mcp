{
  "name": "libresprite-ai-mcp",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for the enhanced LibreSprite live editor",
  "license": "GPL-2.0-only",
  "repository": { "type": "git", "url": "git+https://github.com/maxsunc/libresprite-ai-mcp.git" },
  "homepage": "https://github.com/maxsunc/libresprite-ai-mcp#readme",
  "bugs": { "url": "https://github.com/maxsunc/libresprite-ai-mcp/issues" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:native": "python3 scripts/smoke-test-libresprite.py",
    "test:bridge": "python3 scripts/test-live-bridge.py",
    "doctor": "node dist/index.js --doctor",
    "package:macos": "python3 scripts/package-macos.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
